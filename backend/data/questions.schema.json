{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ozberk-sevinc/crm-soru/questions.schema.json",
  "title": "CRM Soru question bank v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "outcomes",
    "questions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "title",
        "remember"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "remember": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "exam",
        "type",
        "subject",
        "prompt",
        "answer",
        "explanation",
        "outcome_ids",
        "difficulty"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "exam": {
          "enum": [
            "IMAT",
            "TOLC-I",
            "TOLC-F"
          ]
        },
        "type": {
          "enum": [
            "single_choice",
            "numeric"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "outcome_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "single_choice"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 2
              },
              "answer": {
                "required": [
                  "option_id"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "value"
                      ]
                    },
                    {
                      "required": [
                        "tolerance"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "numeric"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "maxItems": 0
              },
              "answer": {
                "required": [
                  "value"
                ],
                "not": {
                  "required": [
                    "option_id"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "misconception": {
          "type": "string"
        },
        "outcome_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
