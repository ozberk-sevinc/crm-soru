LISTEN_ADDR=127.0.0.1:8080
QUESTION_BANK=data/questions.json
STATE_PATH=var/state.json
# Generate your own random secret with: openssl rand -hex 32
ADMIN_TOKEN=
DEMO_MODE=false
# Google Web OAuth client ID (comma-separated if multiple approved clients).
GOOGLE_CLIENT_IDS=
# Explicit admin identities. Email matching requires a Google-authoritative email.
GOOGLE_ADMIN_EMAILS=
# Optional stable Google subject IDs for admins (including third-party email accounts).
GOOGLE_ADMIN_SUBJECTS=
