{
  "name": "crm-soru-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "format:check": "prettier --check App.tsx app.config.ts index.ts src tsconfig.json app.json eas.json package.json"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~58.0.22",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.67.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
